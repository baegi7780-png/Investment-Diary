{
  "name": "investment-diary",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-journal-db",
      "database_id": "b131003e-fc0c-476d-a226-7229192edf1c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOW_HTTP_LOCAL": "true"
  },
  "workers_dev": true,
  "triggers": {"crons": ["0 0 * * *"]},
  "preview_urls": false
}
