{
  "name": "stock-journal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"stock-journal-db","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {"ALLOW_HTTP_LOCAL":"true"}
}
